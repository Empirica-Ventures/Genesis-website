# Copy this to .env.local for local `vercel dev`, and set the same values
# as Environment Variables in the Vercel project dashboard for production.
# Never commit the real values.

# The shared password members type in to reach the upload page.
UPLOAD_PASSWORD=change-me

# Random secret used to sign the login session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Populated automatically once you connect a Blob store to this project in
# the Vercel dashboard (Storage tab -> Create Database -> Blob). You do not
# need to set this by hand.
# BLOB_READ_WRITE_TOKEN=

# Optional: how many of the most recent uploads to keep. Older ones are
# deleted automatically after each new upload. Defaults to 30.
# MAX_FILES=30
