{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/assets/files/business-card.pdf",
      "destination": "/assets/files/Structured%20PBL%20by%20Genesis%20Education%20Solutions.pdf",
      "permanent": true
    },
    {
      "source": "/education-solutions.html",
      "destination": "/program",
      "permanent": true
    },
    {
      "source": "/education-solutions",
      "destination": "/program",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/files/Structured%20PBL%20by%20Genesis%20Education%20Solutions.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Structured PBL by Genesis Education Solutions.pdf\""
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/web/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/booklet/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
